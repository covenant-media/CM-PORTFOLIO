# ─────────────────────────────────────────────────────────────────────────────
# Covenant Media — environment configuration
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---
NODE_ENV=development

# Absolute base URL of the deployed site. Used for canonical URLs, OG tags and
# sitemap generation. Leave unset in local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---
# `pglite`  = embedded PostgreSQL (WASM). Zero-setup, used for local dev/demo.
# `postgres`= production driver (node-postgres) against a real PostgreSQL server.
DB_DRIVER=pglite
# Where the embedded database persists (pglite driver only).
CM_DATA_DIR=.cm-data

# Production PostgreSQL connection string (required when DB_DRIVER=postgres).
# DATABASE_URL=postgresql://covenant:changeme@127.0.0.1:5432/covenant_media

# --- Admin authentication ---
# 64+ char random secret. Generates with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=dev-only-insecure-secret-change-me-please-0123456789abcdef

# Bootstrap admin account, used by `npm run db:seed` (and only if no user exists).
# CHANGE BOTH BEFORE GOING LIVE, or log in and change the password in /admin.
ADMIN_EMAIL=covenant@covenantmedia.com
ADMIN_PASSWORD=

# --- Session cookie ---
# Set Secure=true only over HTTPS.
COOKIE_SECURE=false

# --- Storage (Media Library) ---
# `local` writes into ./public/uploads (served through the app / CDN in front).
# `s3`    targets any S3-compatible object store (R2, B2, MinIO, WASabi...).
STORAGE_DRIVER=local
STORAGE_MAX_UPLOAD_MB=32
# S3/R2 example:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=covenant-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# --- Optional third-party video metadata (all optional, graceful fallbacks) ---
# YouTube Data API v3 key. Used only server-side for richer metadata; the CMS
# works fully without it (oEmbed + URL parsing fallbacks).
YOUTUBE_API_KEY=
# GitHub token for optional repo metadata on Tech projects.
GITHUB_TOKEN=

# --- Email notifications for contact submissions ---
# Leave blank to disable outbound email (submissions are always stored in DB).
# SMTP_HOST= smtp://user:pass@host:587
SMTP_URL=
NOTIFY_EMAIL=

# --- Analytics ---
# Privacy-friendly, first-party event capture is always on (ContactSubmission +
# CMEvent tables). Set a provider to also forward events.
ANALYTICS_PROVIDER=first-party
GOOGLE_SITE_VERIFICATION=
