{
  "name": "covenant-media-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Covenant Media \u2014 unified digital platform: main brand site, Media Portfolio, Tech Portfolio and one shared Covenant CMS.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "setup": "node --import tsx scripts/db.ts migrate && node --import tsx scripts/db.ts seed",
    "db:migrate": "node --import tsx scripts/db.ts migrate",
    "db:seed": "node --import tsx scripts/db.ts seed",
    "db:reset": "node --import tsx scripts/db.ts reset && node --import tsx scripts/db.ts migrate && node --import tsx scripts/db.ts seed",
    "db:status": "node --import tsx scripts/db.ts status",
    "db:reset-admin": "node --import tsx scripts/reset-admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dev:next": "next dev -p 3000 -H 0.0.0.0",
    "db:serve": "node --import tsx scripts/pglite-socket.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "framer-motion": "^12.23.0",
    "marked": "^18.0.1",
    "next": "^15.5.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "eslint-plugin-react-hooks": "^5.2.0",
    "simple-icons": "^16.29.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
